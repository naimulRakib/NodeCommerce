{
  "name": "nodecom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:safe": "NODE_OPTIONS='--max-old-space-size=2048' next dev --turbo",
    "dev:fresh": "rm -rf .next && prisma generate && next dev --turbo",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "verify-demo": "npx tsx --env-file=.env.local --env-file=.env scripts/hackathon-verify.ts",
    "verify-demo:watch": "npx nodemon --exec npx tsx --env-file=.env.local --env-file=.env scripts/hackathon-verify.ts",
    "get-dev-logins": "npx tsx --env-file=.env.local --env-file=.env scripts/get-dev-logins.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed:supply-chain": "node --env-file=.env.local --env-file=.env seed-supply-chain.js",
    "db:seed:dashboard": "node --env-file=.env.local --env-file=.env scripts/seed-dashboard.js",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "postinstall": "prisma generate",
    "backfill:seller-codes": "node --env-file=.env scripts/backfill-seller-codes.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "bangladesh-geo-data": "^4.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "next": "16.2.7",
    "pg": "^8.21.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-window": "^2.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
